# Copy this file to .env and fill in your own values.
# Every language version of every codelab reads its settings from .env in this directory.
# Variables already exported in your shell take precedence over this file.

# --- Conductor connection (required by every codelab) ---
# Replace with your own cluster's URL if you are not using the free developer edition.
CONDUCTOR_SERVER_URL=https://developer.orkescloud.com/api
# Create an application access key under Access Control > Applications.
CONDUCTOR_AUTH_KEY=your_key_id
CONDUCTOR_AUTH_SECRET=your_key_secret

# --- Agent LLM (required by every codelab) ---
# The name of an integration added to your Orkes account.
CONDUCTOR_INTEGRATION_NAME=your_integration_name_here
# The model that integration uses, in 'provider/model' format.
CONDUCTOR_AGENT_LLM_MODEL=openai/gpt-5-nano

# --- Webhooks codelab ---
# The ID of your webhook, from the Webhook tab of the Orkes Conductor UI.
WEBHOOK_ID=your_webhook_id_here
# The value of the "source" header you added to that webhook.
WEBHOOK_SOURCE_HEADER=your_source_header_here

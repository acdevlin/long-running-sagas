<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WebhooksCodelab</RootNamespace>
  </PropertyGroup>

  <!--
    The agent in these codelabs runs on the Conductor server through an Orkes
    integration, so none of the conductor-ai framework bridges (OpenAI, Google
    ADK, Semantic Kernel) are required.
  -->
  <ItemGroup>
    <PackageReference Include="conductor-ai" Version="3.0.0" />
    <PackageReference Include="conductor-csharp" Version="3.0.0" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!--
    conductor-csharp 3.0.0 depends on OpenTelemetry.Api 1.15.1, which has a known
    vulnerability (GHSA-g94r-2vxg-569j). Referencing the fixed version directly makes
    the build use it instead.
  -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
  </ItemGroup>

</Project>
